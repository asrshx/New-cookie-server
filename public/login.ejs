<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Xmarty Ayush King- Secure Login</title>
    <link rel="icon" href="data:image/svg+xml;base64,">
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700;800&family=Orbitron:wght@400;500;600;700;800;900&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* ==================== PERFORMANCE OPTIMIZED CSS ==================== */
        :root {
            --cyber-blue: #00f3ff;
            --neon-purple: #b026ff;
            --matrix-green: #00ff41;
            --dark-bg: #0a0a12;
            --panel-bg: rgba(16, 16, 24, 0.85);
            --panel-border: rgba(0, 243, 255, 0.2);
            --danger-red: #ff003c;
            --text-primary: #ffffff;
            --text-secondary: #a0a0c0;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
            animation-duration: 0.3s !important;
            transition-duration: 0.3s !important;
        }

        body {
            font-family: 'Rajdhani', sans-serif;
            background: var(--dark-bg);
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        .glitch-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: 
                radial-gradient(circle at 10% 20%, rgba(0, 243, 255, 0.03) 0%, transparent 20%),
                radial-gradient(circle at 90% 80%, rgba(176, 38, 255, 0.03) 0%, transparent 20%);
            z-index: -2;
        }

        .main-container {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            position: relative;
            z-index: 1;
        }

        /* ==================== OPTIMIZED HEADER ==================== */
        .cyber-header {
            background: rgba(10, 10, 18, 0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--panel-border);
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: relative;
        }

        .cyber-header::before {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            width: 100%;
            height: 1px;
            background: linear-gradient(90deg, 
                transparent, 
                var(--cyber-blue), 
                var(--neon-purple),
                transparent);
            animation: scanline 4s linear infinite;
        }

        @keyframes scanline {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }

        .logo-section {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-icon {
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, var(--cyber-blue), var(--neon-purple));
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            transform: translateZ(0);
        }

        .logo-text {
            font-family: 'Orbitron', monospace;
            font-weight: 800;
            font-size: 1.6rem;
            background: linear-gradient(90deg, var(--cyber-blue), var(--neon-purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .owner-badge {
            background: rgba(0, 255, 65, 0.1);
            border: 1px solid rgba(0, 255, 65, 0.3);
            padding: 6px 15px;
            border-radius: 20px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* ==================== OPTIMIZED QUOTE ==================== */
        .quote-section {
            text-align: center;
            padding: 30px 20px;
        }

        .quote-container {
            max-width: 800px;
            margin: 0 auto;
        }

        .quote-text {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.6rem;
            font-weight: 700;
            line-height: 1.3;
            margin-bottom: 12px;
        }

        .quote-author {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.9rem;
            color: var(--neon-purple);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .author-signal {
            width: 8px;
            height: 8px;
            background: var(--matrix-green);
            border-radius: 50%;
        }

        /* ==================== OPTIMIZED LOGIN CONTAINER ==================== */
        .login-wrapper {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 20px;
        }

        .cyber-login-container {
            background: var(--panel-bg);
            backdrop-filter: blur(15px);
            border: 1px solid var(--panel-border);
            border-radius: 15px;
            padding: 40px;
            width: 100%;
            max-width: 450px;
            position: relative;
            overflow: hidden;
            transform: translateZ(0);
            will-change: transform;
        }

        .cyber-login-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, 
                var(--cyber-blue), 
                var(--neon-purple));
        }

        .container-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .container-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.8rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 3px;
            margin-bottom: 8px;
            background: linear-gradient(90deg, var(--cyber-blue), var(--neon-purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .container-subtitle {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.85rem;
            color: var(--text-secondary);
            letter-spacing: 1.5px;
        }

        /* ==================== OPTIMIZED FORM ==================== */
        .input-group {
            margin-bottom: 20px;
            position: relative;
        }

        .input-label {
            display: block;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.85rem;
            color: var(--cyber-blue);
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .input-field {
            width: 100%;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(0, 243, 255, 0.3);
            border-radius: 8px;
            padding: 14px 16px;
            color: var(--text-primary);
            font-family: 'Rajdhani', sans-serif;
            font-size: 1rem;
            font-weight: 500;
            transition: border-color 0.2s ease;
        }

        .input-field:focus {
            outline: none;
            border-color: var(--neon-purple);
        }

        .password-toggle {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            font-size: 1.1rem;
        }

        /* ==================== OPTIMIZED BUTTON ==================== */
        .login-btn {
            width: 100%;
            background: linear-gradient(135deg, var(--cyber-blue), var(--neon-purple));
            border: none;
            border-radius: 10px;
            padding: 16px;
            color: white;
            font-family: 'Orbitron', sans-serif;
            font-size: 1.1rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            transition: transform 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 10px;
            transform: translateZ(0);
        }

        .login-btn:hover {
            transform: translateY(-2px);
        }

        .login-btn.loading {
            opacity: 0.8;
            cursor: wait;
        }

        .btn-loading {
            display: none;
        }

        .btn-loading i {
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* ==================== OPTIMIZED FOOTER ==================== */
        .cyber-footer {
            text-align: center;
            padding: 25px 20px;
            background: rgba(10, 10, 18, 0.8);
            border-top: 1px solid var(--panel-border);
        }

        .signature {
            font-family: 'JetBrains Mono', monospace;
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 8px;
            letter-spacing: 2px;
        }

        .contact-info {
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.9rem;
            color: var(--text-secondary);
            margin-bottom: 12px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            background: rgba(0, 243, 255, 0.1);
            border-radius: 15px;
        }

        .copyright {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.75rem;
            color: var(--text-secondary);
            letter-spacing: 1.5px;
            margin-top: 15px;
        }

        /* ==================== ERROR MESSAGE ==================== */
        .error-message {
            background: rgba(255, 0, 60, 0.1);
            border: 1px solid var(--danger-red);
            border-radius: 8px;
            padding: 12px;
            margin-top: 15px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.85rem;
            color: var(--danger-red);
            display: none;
            text-align: center;
        }

        /* ==================== RESPONSIVE ==================== */
        @media (max-width: 768px) {
            .cyber-header {
                flex-direction: column;
                gap: 12px;
                padding: 12px;
            }
            
            .cyber-login-container {
                padding: 25px 20px;
            }
            
            .quote-text {
                font-size: 1.3rem;
            }
            
            .container-title {
                font-size: 1.5rem;
            }
            
            .contact-info {
                flex-direction: column;
                gap: 8px;
            }
            
            .login-btn {
                font-size: 1rem;
                padding: 14px;
            }
        }

        @media (max-width: 480px) {
            .cyber-login-container {
                padding: 20px 15px;
            }
            
            .quote-text {
                font-size: 1.1rem;
            }
            
            .logo-text {
                font-size: 1.3rem;
            }
        }
    </style>
</head>
<body>
    <div class="glitch-bg"></div>

    <div class="main-container">
        <!-- Cyber Header -->
        <header class="cyber-header">
            <div class="logo-section">
                <div class="logo-icon">
                    <i class="fas fa-tools" style="font-size: 1.3rem; color: white;"></i>
                </div>
                <div class="logo-text">XMARTY AYUSH KING</div>
            </div>
            
            <div class="owner-badge">
                <i class="fas fa-crown"></i>
                <span>OWNER: XMARTY AYUSH KING</span>
            </div>
        </header>

        <!-- Quote Section -->
        <section class="quote-section">
            <div class="quote-container">
                <div class="quote-text">
                    "THE ONLY WAY TO DISCOVER THE LIMITS OF THE POSSIBLE IS TO GO BEYOND THEM"
                </div>
                <div class="quote-author">
                    <div class="author-signal"></div>
                    <span>XMARTY AYUSH KING</span>
                    <div class="author-signal"></div>
                </div>
            </div>
        </section>

        <!-- Login Container -->
        <div class="login-wrapper">
            <div class="cyber-login-container">
                <div class="container-header">
                    <div class="container-title">SECURE LOGIN</div>
                    <div class="container-subtitle">ENTER PASSWORD TO ACCESS TOOL</div>
                </div>

                <form id="loginForm" method="POST" action="/login">
                    <div class="input-group">
                        <label class="input-label">
                            <i class="fas fa-lock"></i>
                            PASSWORD
                        </label>
                        <div style="position: relative;">
                            <input type="password" id="password" name="password" class="input-field" 
                                   placeholder="Enter password" required autocomplete="off">
                            <button type="button" class="password-toggle" id="togglePassword">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="login-btn" id="loginButton">
                        <i class="fas fa-sign-in-alt"></i>
                        <span class="btn-text">LOGIN</span>
                        <span class="btn-loading">
                            <i class="fas fa-spinner"></i> LOGGING IN...
                        </span>
                    </button>
                </form>

                <div class="error-message" id="errorMessage">
                    <i class="fas fa-exclamation-triangle"></i>
                    ACCESS DENIED: INVALID PASSWORD
                </div>
            </div>
        </div>

        <!-- Cyber Footer -->
        <footer class="cyber-footer">
            <div class="signature">
                XMARTY AYUSH KING
            </div>
            
            <div class="contact-info">
                <div class="contact-item">
                    <i class="fas fa-phone-alt"></i>
                    <span>CONTACT: +91 9919180262</span>
                </div>
                <div class="contact-item">
                    <i class="fas fa-code"></i>
                    <span>TOOL BY: XMARTY AYUSH KING</span>
                </div>
            </div>
            
            <div class="copyright">
                © 2026 | OFFLINE SERVER | OWNER: XMARTY AYUSH KING
            </div>
        </footer>
    </div>

    <script>
        // Password Toggle
        const togglePassword = document.getElementById('togglePassword');
        const password = document.getElementById('password');
        
        if (togglePassword && password) {
            togglePassword.addEventListener('click', function() {
                const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
                password.setAttribute('type', type);
                this.innerHTML = type === 'password' ? '<i class="fas fa-eye"></i>' : '<i class="fas fa-eye-slash"></i>';
            });
        }

        // Login Form Submission
        const loginForm = document.getElementById('loginForm');
        const loginButton = document.getElementById('loginButton');
        const errorMessage = document.getElementById('errorMessage');

        if (loginForm && loginButton) {
            loginForm.addEventListener('submit', function(e) {
                e.preventDefault();
                
                const passwordValue = password.value.trim();
                
                // Show loading state
                loginButton.classList.add('loading');
                const btnText = loginButton.querySelector('.btn-text');
                const btnLoading = loginButton.querySelector('.btn-loading');
                
                if (btnText) btnText.style.display = 'none';
                if (btnLoading) btnLoading.style.display = 'inline';
                
                loginButton.disabled = true;
                if (errorMessage) errorMessage.style.display = 'none';
                
                // Send request to server
                fetch('/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `password=${encodeURIComponent(passwordValue)}`
                })
                .then(response => {
                    if (response.redirected) {
                        // Success - redirect to dashboard
                        window.location.href = '/dashboard';
                    } else {
                        // Error
                        if (errorMessage) errorMessage.style.display = 'block';
                        resetLoginButton();
                    }
                })
                .catch(error => {
                    console.error('Login error:', error);
                    if (errorMessage) errorMessage.style.display = 'block';
                    resetLoginButton();
                });
            });
        }

        function resetLoginButton() {
            if (loginButton) {
                loginButton.classList.remove('loading');
                loginButton.disabled = false;
                
                const btnText = loginButton.querySelector('.btn-text');
                const btnLoading = loginButton.querySelector('.btn-loading');
                
                if (btnText) btnText.style.display = 'inline';
                if (btnLoading) btnLoading.style.display = 'none';
            }
        }

        // Simple typewriter effect
        const quote = document.querySelector('.quote-text');
        if (quote) {
            const originalText = quote.textContent;
            quote.textContent = '';
            
            let i = 0;
            function typeWriter() {
                if (i < originalText.length) {
                    quote.textContent += originalText.charAt(i);
                    i++;
                    setTimeout(typeWriter, 50);
                }
            }
            
            // Start typing after page load
            setTimeout(typeWriter, 500);
        }

        // Add ripple effect to button
        if (loginButton) {
            loginButton.addEventListener('click', function(e) {
                const ripple = document.createElement('span');
                const rect = this.getBoundingClientRect();
                const size = Math.max(rect.width, rect.height);
                const x = e.clientX - rect.left - size / 2;
                const y = e.clientY - rect.top - size / 2;
                
                ripple.style.cssText = `
                    position: absolute;
                    border-radius: 50%;
                    background: rgba(255, 255, 255, 0.2);
                    transform: scale(0);
                    animation: ripple 0.4s linear;
                    pointer-events: none;
                    width: ${size}px;
                    height: ${size}px;
                    left: ${x}px;
                    top: ${y}px;
                `;
                
                this.appendChild(ripple);
                
                setTimeout(() => {
                    ripple.remove();
                }, 400);
            });
        }

        // Add CSS for ripple
        const rippleStyle = document.createElement('style');
        rippleStyle.textContent = `
            @keyframes ripple {
                to {
                    transform: scale(2);
                    opacity: 0;
                }
            }
        `;
        document.head.appendChild(rippleStyle);
    </script>
</body>
</html>
