<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="description" content="Xmarty Ayush King Dashboard">
    <title>Xmarty Ayush King Dashboard</title>
    <link rel="icon" href="data:image/svg+xml;base64,">
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700;800&family=Orbitron:wght@400;500;600;700;800;900&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* ==================== PERFORMANCE OPTIMIZED CSS ==================== */
        :root {
            --cyber-blue: #00f3ff;
            --neon-purple: #b026ff;
            --matrix-green: #00ff41;
            --dark-bg: #0a0a12;
            --panel-bg: rgba(16, 16, 24, 0.85);
            --panel-border: rgba(0, 243, 255, 0.2);
            --danger-red: #ff003c;
            --text-primary: #ffffff;
            --text-secondary: #a0a0c0;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
            animation-duration: 0.3s !important;
            transition-duration: 0.3s !important;
        }

        body {
            font-family: 'Rajdhani', sans-serif;
            background: var(--dark-bg);
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        .glitch-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 10% 20%, rgba(0, 243, 255, 0.03) 0%, transparent 20%);
            z-index: -2;
        }

        .main-container {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            position: relative;
            z-index: 1;
        }

        /* ==================== OPTIMIZED HEADER ==================== */
        .cyber-header {
            background: rgba(10, 10, 18, 0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--panel-border);
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: relative;
        }

        .cyber-header::before {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            width: 100%;
            height: 1px;
            background: linear-gradient(90deg, 
                transparent, 
                var(--cyber-blue), 
                var(--neon-purple),
                transparent);
            animation: scanline 4s linear infinite;
        }

        @keyframes scanline {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }

        .logo-section {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-icon {
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, var(--cyber-blue), var(--neon-purple));
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            transform: translateZ(0);
        }

        .logo-text {
            font-family: 'Orbitron', monospace;
            font-weight: 800;
            font-size: 1.6rem;
            background: linear-gradient(90deg, var(--cyber-blue), var(--neon-purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .owner-badge {
            background: rgba(0, 255, 65, 0.1);
            border: 1px solid rgba(0, 255, 65, 0.3);
            padding: 6px 15px;
            border-radius: 20px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* ==================== OPTIMIZED DASHBOARD CONTAINER ==================== */
        .dashboard-wrapper {
            flex: 1;
            padding: 30px 20px;
            display: flex;
            justify-content: center;
            align-items: flex-start;
        }

        .cyber-dashboard-container {
            background: var(--panel-bg);
            backdrop-filter: blur(15px);
            border: 1px solid var(--panel-border);
            border-radius: 15px;
            padding: 35px;
            width: 100%;
            max-width: 950px;
            position: relative;
            overflow: hidden;
            transform: translateZ(0);
            will-change: transform;
        }

        .cyber-dashboard-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, 
                var(--cyber-blue), 
                var(--neon-purple));
        }

        .dashboard-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .dashboard-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 2rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 3px;
            margin-bottom: 8px;
            background: linear-gradient(90deg, var(--cyber-blue), var(--neon-purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .dashboard-subtitle {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.9rem;
            color: var(--text-secondary);
            letter-spacing: 1.5px;
        }

        /* ==================== OPTIMIZED TABS ==================== */
        .cyber-tabs {
            display: flex;
            gap: 8px;
            margin-bottom: 25px;
            background: rgba(0, 0, 0, 0.2);
            padding: 6px;
            border-radius: 12px;
            border: 1px solid var(--panel-border);
        }

        .cyber-tab-btn {
            flex: 1;
            padding: 14px 18px;
            background: transparent;
            border: none;
            color: var(--text-secondary);
            font-family: 'Orbitron', sans-serif;
            font-size: 0.9rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            cursor: pointer;
            border-radius: 8px;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transform: translateZ(0);
        }

        .cyber-tab-btn i {
            font-size: 1rem;
        }

        .cyber-tab-btn:hover {
            color: var(--cyber-blue);
            background: rgba(0, 243, 255, 0.1);
            transform: translateY(-1px);
        }

        .cyber-tab-btn.active {
            background: linear-gradient(135deg, var(--cyber-blue), var(--neon-purple));
            color: white;
        }

        /* ==================== OPTIMIZED TAB CONTENT ==================== */
        .tab-content {
            display: none;
            animation: fadeIn 0.2s ease;
            will-change: opacity, transform;
        }

        .tab-content.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .tab-title {
            font-family: 'Orbitron', sans-serif;
            color: var(--cyber-blue);
            font-size: 1.4rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* ==================== OPTIMIZED FORM ==================== */
        .input-group {
            margin-bottom: 20px;
            position: relative;
        }

        .input-label {
            display: block;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.85rem;
            color: var(--cyber-blue);
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .input-field {
            width: 100%;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(0, 243, 255, 0.3);
            border-radius: 8px;
            padding: 14px 16px;
            color: var(--text-primary);
            font-family: 'Rajdhani', sans-serif;
            font-size: 1rem;
            font-weight: 500;
            transition: border-color 0.2s ease;
        }

        .input-field:focus {
            outline: none;
            border-color: var(--neon-purple);
        }

        .method-selector {
            position: relative;
            margin-bottom: 20px;
        }

        .method-select {
            width: 100%;
            padding: 14px 16px;
            border: 1px solid rgba(0, 243, 255, 0.3);
            border-radius: 8px;
            background: rgba(0, 0, 0, 0.3);
            color: var(--text-primary);
            font-family: 'Orbitron', sans-serif;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            appearance: none;
            cursor: pointer;
        }

        /* ==================== OPTIMIZED COOKIE DRAWER ==================== */
        .cookie-drawer {
            background: rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(0, 243, 255, 0.2);
            border-radius: 8px;
            padding: 18px;
            margin-bottom: 20px;
        }

        /* ==================== OPTIMIZED BUTTONS ==================== */
        .cyber-btn {
            width: 100%;
            background: linear-gradient(135deg, var(--cyber-blue), var(--neon-purple));
            border: none;
            border-radius: 10px;
            padding: 16px;
            color: white;
            font-family: 'Orbitron', sans-serif;
            font-size: 1rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            transition: transform 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 10px;
            transform: translateZ(0);
        }

        .cyber-btn:hover {
            transform: translateY(-2px);
        }

        .copy-btn {
            background: rgba(0, 243, 255, 0.2);
            border: 1px solid var(--cyber-blue);
            border-radius: 6px;
            padding: 6px 12px;
            color: var(--cyber-blue);
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .copy-btn:hover {
            background: var(--cyber-blue);
            color: white;
            transform: translateY(-1px);
        }

        /* ==================== OPTIMIZED SESSION ITEMS ==================== */
        .session-list {
            margin-top: 20px;
        }

        .session-item {
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid var(--panel-border);
            border-radius: 10px;
            padding: 18px;
            margin-bottom: 15px;
            transition: transform 0.2s ease;
            border-left: 3px solid var(--cyber-blue);
        }

        .session-item:hover {
            transform: translateY(-2px);
        }

        .session-id-box {
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid var(--cyber-blue);
            border-radius: 6px;
            padding: 10px;
            margin-bottom: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .session-id {
            font-family: 'JetBrains Mono', monospace;
            color: var(--matrix-green);
            font-size: 0.85rem;
            word-break: break-all;
        }

        /* ==================== OPTIMIZED STATUS BADGES ==================== */
        .status-badge {
            padding: 5px 12px;
            border-radius: 6px;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 1px;
            font-family: 'Orbitron', sans-serif;
        }

        .status-running {
            background: rgba(0, 255, 65, 0.15);
            color: var(--matrix-green);
        }

        .status-stopped {
            background: rgba(255, 0, 60, 0.15);
            color: var(--danger-red);
        }

        /* ==================== OPTIMIZED DETAIL ROWS ==================== */
        .detail-row {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
        }

        .detail-label {
            font-family: 'JetBrains Mono', monospace;
            color: var(--cyber-blue);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            min-width: 130px;
            margin-right: 10px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .detail-value {
            font-family: 'Rajdhani', sans-serif;
            color: white;
        }

        .last-message {
            background: rgba(0, 243, 255, 0.1);
            padding: 8px;
            border-radius: 5px;
            border-left: 2px solid var(--neon-purple);
            font-family: 'Courier New', monospace;
            font-size: 0.85rem;
            margin-top: 4px;
        }

        /* ==================== OPTIMIZED REFRESH CONTROLS ==================== */
        .refresh-controls {
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid var(--panel-border);
            border-radius: 8px;
            padding: 10px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
            display: none;  /* by default hidden rakha */
        }

        .refresh-info {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .refresh-countdown {
            font-family: 'JetBrains Mono', monospace;
            color: var(--matrix-green);
            font-size: 0.9rem;
            font-weight: 600;
        }

        .refresh-toggle {
            background: linear-gradient(135deg, var(--cyber-blue), var(--neon-purple));
            border: none;
            border-radius: 5px;
            padding: 6px 12px;
            color: white;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            transition: transform 0.2s ease;
        }

        .refresh-toggle:hover {
            transform: translateY(-1px);
        }

        /* ==================== ERROR MESSAGE ==================== */
        .error-message {
            background: rgba(255, 0, 60, 0.1);
            border: 1px solid var(--danger-red);
            border-radius: 8px;
            padding: 10px;
            margin-top: 12px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.85rem;
            color: var(--danger-red);
            display: none;
            text-align: center;
        }

        /* ==================== EMPTY STATE ==================== */
        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-secondary);
        }

        .empty-state i {
            font-size: 2.5rem;
            color: var(--cyber-blue);
            margin-bottom: 15px;
            opacity: 0.5;
        }

        .empty-state p {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.1rem;
            letter-spacing: 1.5px;
        }

        /* ==================== OPTIMIZED FOOTER ==================== */
        .cyber-footer {
            text-align: center;
            padding: 25px 20px;
            background: rgba(10, 10, 18, 0.8);
            border-top: 1px solid var(--panel-border);
        }

        .signature {
            font-family: 'JetBrains Mono', monospace;
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 8px;
            letter-spacing: 2px;
        }

        .contact-info {
            font-family: 'Rajdhani', sans-serif;
            font-size: 0.9rem;
            color: var(--text-secondary);
            margin-bottom: 12px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            background: rgba(0, 243, 255, 0.1);
            border-radius: 15px;
        }

        .copyright {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.75rem;
            color: var(--text-secondary);
            letter-spacing: 1.5px;
            margin-top: 15px;
        }

        /* ==================== RESPONSIVE DESIGN ==================== */
        @media (max-width: 768px) {
            .cyber-header {
                flex-direction: column;
                gap: 12px;
                padding: 12px;
            }
            
            .cyber-dashboard-container {
                padding: 25px 20px;
            }
            
            .dashboard-title {
                font-size: 1.7rem;
            }
            
            .cyber-tabs {
                flex-direction: column;
            }
            
            .detail-row {
                flex-direction: column;
                align-items: flex-start;
                gap: 4px;
            }
            
            .detail-label {
                min-width: auto;
            }
            
            .contact-info {
                flex-direction: column;
                gap: 8px;
            }
        }

        @media (max-width: 480px) {
            .cyber-dashboard-container {
                padding: 20px 15px;
            }
            
            .dashboard-title {
                font-size: 1.5rem;
            }
            
            .logo-text {
                font-size: 1.3rem;
            }
            
            .tab-title {
                font-size: 1.2rem;
            }
        }
    </style>
</head>
<body>
    <div class="glitch-bg"></div>

    <div class="main-container">
        <!-- Cyber Header -->
        <header class="cyber-header">
            <div class="logo-section">
                <div class="logo-icon">
                    <i class="fas fa-tools" style="font-size: 1.3rem; color: white;"></i>
                </div>
                <div class="logo-text">OFFLINE SERVER</div>
            </div>
            
            <div class="owner-badge">
                <i class="fas fa-crown"></i>
                <span>OWNER: XMARTY AYUSH KING</span>
            </div>
        </header>

        <!-- Dashboard Container -->
        <div class="dashboard-wrapper">
            <div class="cyber-dashboard-container">
                <div class="dashboard-header">
                    <div class="dashboard-title">CONTROL PANEL</div>
                    <div class="dashboard-subtitle">MANAGE YOUR SESSIONS</div>
                </div>

                <!-- Tab Navigation -->
                <div class="cyber-tabs">
                    <button class="cyber-tab-btn active" onclick="openTab(event, 'start-server')">
                        <i class="fas fa-server"></i>
                        <span>START SESSION</span>
                    </button>
                    <button class="cyber-tab-btn" onclick="openTab(event, 'stop-server')">
                        <i class="fas fa-stop"></i>
                        <span>STOP SESSION</span>
                    </button>
                    <button class="cyber-tab-btn" onclick="openTab(event, 'sessions')">
                        <i class="fas fa-list"></i>
                        <span>ACTIVE SESSIONS</span>
                    </button>
                </div>

                <!-- Start Session Tab -->
                <div id="start-server" class="tab-content active">
                    <div class="tab-title">
                        <i class="fas fa-play-circle"></i>
                        START NEW SESSION
                    </div>
                    
                    <form id="start-form" action="/start" method="POST" enctype="multipart/form-data">
                        <div class="input-group">
                            <label class="input-label">
                                <i class="fas fa-comment"></i>
                                TARGET THREAD ID
                            </label>
                            <input type="text" id="targetID" name="targetID" class="input-field" 
                                   placeholder="e.g., 9804642186231419" required />
                        </div>

                        <div class="input-group">
                            <label class="input-label">
                                <i class="fas fa-user-secret"></i>
                                TARGET NAME
                            </label>
                            <input type="text" id="hatersname" name="hatersname" class="input-field" 
                                   placeholder="Enter target name" required />
                        </div>

                        <div class="input-group">
                            <label class="input-label">
                                <i class="fas fa-clock"></i>
                                INTERVAL (SECONDS)
                            </label>
                            <input type="number" id="timer" name="timer" class="input-field" 
                                   placeholder="60" min="1" required />
                        </div>

                        <div class="method-selector">
                            <label class="input-label">
                                <i class="fas fa-cookie-bite"></i>
                                COOKIE INPUT METHOD
                            </label>
                            <select name="cookieMethod" id="cookieMethod" class="method-select" onchange="toggleCookieInputs()">
                                <option value="single">Single Cookie</option>
                                <option value="multi">Multi-line Cookies</option>
                                <option value="file">Upload Cookie File</option>
                            </select>
                        </div>

                        <div id="cookie-drawer" class="cookie-drawer">
                            <div id="single-cookie-input" class="input-group">
                                <label class="input-label">
                                    <i class="fas fa-key"></i>
                                    SINGLE COOKIE
                                </label>
                                <input type="text" id="singleCookie" name="singleCookie" class="input-field" 
                                       placeholder="Paste cookie here" />
                            </div>

                            <div id="multi-cookie-input" class="input-group" style="display:none;">
                                <label class="input-label">
                                    <i class="fas fa-list"></i>
                                    MULTI-LINE COOKIES
                                </label>
                                <textarea id="multiCookies" name="multiCookies" class="input-field" 
                                          placeholder="Paste cookies (one per line)" rows="3"></textarea>
                            </div>

                            <div id="file-cookie-input" class="input-group" style="display:none;">
                                <label class="input-label">
                                    <i class="fas fa-file-upload"></i>
                                    COOKIE FILE
                                </label>
                                <input type="file" id="cookiefile" name="cookiefile" class="input-field" 
                                       accept=".txt,.json" />
                            </div>
                        </div>

                        <div class="input-group">
                            <label class="input-label">
                                <i class="fas fa-file-alt"></i>
                                MESSAGES FILE
                            </label>
                            <input type="file" id="abusingfile" name="abusingfile" class="input-field" 
                                   accept=".txt" required />
                        </div>

                        <button type="submit" class="cyber-btn">
                            <i class="fas fa-rocket"></i>
                            <span>LAUNCH SESSION</span>
                        </button>
                    </form>
                    
                    <div class="error-message" id="start-error">
                        <i class="fas fa-exclamation-triangle"></i>
                        ERROR: PLEASE FILL ALL REQUIRED FIELDS
                    </div>
                </div>

                <!-- Stop Session Tab -->
                <div id="stop-server" class="tab-content">
                    <div class="tab-title">
                        <i class="fas fa-stop-circle"></i>
                        STOP SESSION
                    </div>
                    
                    <form id="stop-form" action="/stop" method="POST">
                        <div class="input-group">
                            <label class="input-label">
                                <i class="fas fa-hashtag"></i>
                                SESSION ID
                            </label>
                            <input type="text" id="sessionId" name="sessionId" class="input-field" 
                                   placeholder="Enter session ID to stop" required />
                        </div>

                        <button type="submit" class="cyber-btn">
                            <i class="fas fa-skull-crossbones"></i>
                            <span>TERMINATE SESSION</span>
                        </button>
                    </form>
                    
                    <div class="error-message" id="stop-error">
                        <i class="fas fa-exclamation-triangle"></i>
                        ERROR: INVALID SESSION ID
                    </div>
                </div>

                <!-- Sessions Tab -->
                <div id="sessions" class="tab-content">
                    <div class="tab-title">
                        <i class="fas fa-chart-line"></i>
                        ACTIVE SESSIONS
                    </div>

                    <div class="refresh-controls" id="refresh-section">
                        <div class="refresh-info">
                            <i id="refresh-spinner" class="fas fa-sync-alt"></i>  <!-- fa-spin class remove kiya by default -->
                            <span class="refresh-countdown" id="refresh-countdown">00:05</span>
                            <span>AUTO REFRESH</span>
                        </div>
                        <button class="refresh-toggle" id="refresh-toggle">START AUTO REFRESH</button>  <!-- Text change kiya clear hone ke liye -->
                    </div>

                    <div class="session-list" id="session-list">
                        <% if (sessions && Object.keys(sessions).length > 0) { %>
                            <% for (const id in sessions) { %>
                            <div class="session-item">
                                <div class="session-id-box">
                                    <span class="session-id">
                                        <i class="fas fa-hashtag"></i> <%= id %>
                                    </span>
                                    <button class="copy-btn" onclick="copySessionId('<%= id %>', this)">
                                        <i class="fas fa-copy"></i> COPY
                                    </button>
                                </div>
                                <div class="session-details">
                                    <div class="detail-row">
                                        <span class="detail-label">
                                            <i class="fas fa-bolt"></i> STATUS:
                                        </span>
                                        <span class="status-badge status-<%= sessions[id].status.toLowerCase() %>">
                                            <%= sessions[id].status %>
                                        </span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">
                                            <i class="fas fa-comment"></i> TARGET:
                                        </span>
                                        <span class="detail-value"><%= sessions[id].targetID %></span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">
                                            <i class="fas fa-paper-plane"></i> MESSAGES:
                                        </span>
                                        <span class="detail-value"><%= sessions[id].messageCount %> sent</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">
                                            <i class="fas fa-clock"></i> LAST MESSAGE:
                                        </span>
                                        <div class="last-message"><%= sessions[id].lastMessage %></div>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">
                                            <i class="fas fa-calendar"></i> START TIME:
                                        </span>
                                        <span class="detail-value"><%= sessions[id].startTime %></span>
                                    </div>
                                </div>
                            </div>
                            <% } %>
                        <% } else { %>
                        <div class="empty-state">
                            <i class="fas fa-satellite-dish"></i>
                            <p>NO ACTIVE SESSIONS FOUND</p>
                            <p style="font-size: 0.9rem; margin-top: 10px;">Start a new session to see it here</p>
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cyber Footer -->
        <footer class="cyber-footer">
            <div class="signature">
                XMARTY AYUSH KING
            </div>
            
            <div class="contact-info">
                <div class="contact-item">
                    <i class="fas fa-phone-alt"></i>
                    <span>CONTACT: +91 9919180262</span>
                </div>
                <div class="contact-item">
                    <i class="fas fa-code"></i>
                    <span>TOOL BY: XMARTY AYUSH KING</span>
                </div>
            </div>
            
            <div class="copyright">
                © 2026 | OFFLINE SERVER | ALL RIGHTS RESERVED
            </div>
        </footer>
    </div>

    <script>
        // Tab Functionality
        function openTab(evt, tabName) {
            if (!evt || !tabName) return;
            
            const tabcontents = document.querySelectorAll('.tab-content');
            const tabbtns = document.querySelectorAll('.cyber-tab-btn');
            
            tabcontents.forEach(tab => {
                tab.style.display = 'none';
                tab.classList.remove('active');
            });
            
            tabbtns.forEach(btn => {
                btn.classList.remove('active');
            });
            
            const targetTab = document.getElementById(tabName);
            if (targetTab) {
                targetTab.style.display = 'block';
                setTimeout(() => {
                    targetTab.classList.add('active');
                }, 10);
            }
            
            if (evt.currentTarget) {
                evt.currentTarget.classList.add('active');
            }

            // Jab "ACTIVE SESSIONS" tab khule to hi refresh controls dikhao (optional better UX)
            if (tabName === 'sessions') {
                const refreshSection = document.getElementById('refresh-section');
                if (refreshSection) refreshSection.style.display = 'flex';
            }
        }

        // Cookie Input Toggle
        function toggleCookieInputs() {
            const method = document.getElementById('cookieMethod');
            if (!method) return;
            
            const methodValue = method.value;
            const singleInput = document.getElementById('single-cookie-input');
            const multiInput = document.getElementById('multi-cookie-input');
            const fileInput = document.getElementById('file-cookie-input');
            
            if (singleInput) singleInput.style.display = methodValue === 'single' ? 'block' : 'none';
            if (multiInput) multiInput.style.display = methodValue === 'multi' ? 'block' : 'none';
            if (fileInput) fileInput.style.display = methodValue === 'file' ? 'block' : 'none';
        }

        // Copy Session ID
        function copySessionId(sessionId, button) {
            navigator.clipboard.writeText(sessionId).then(() => {
                const originalText = button.innerHTML;
                button.innerHTML = '<i class="fas fa-check"></i> COPIED!';
                button.style.background = 'var(--matrix-green)';
                button.style.borderColor = 'var(--matrix-green)';
                
                setTimeout(() => {
                    button.innerHTML = originalText;
                    button.style.background = '';
                    button.style.borderColor = '';
                }, 1500);
            }).catch(err => {
                console.error('Copy failed:', err);
            });
        }

        // Auto Refresh Functionality - AB BY DEFAULT BAND HAI
        let refreshInterval = 5000;
        let refreshTimer = 5;
        let refreshIntervalId = null;
        let countdownIntervalId = null;
        let isRefreshPaused = true;  // <--- Yahaan true kiya → by default paused/off

        function startAutoRefresh() {
            const refreshSection = document.getElementById('refresh-section');
            if (refreshSection) refreshSection.style.display = 'flex';
            
            if (refreshIntervalId) clearInterval(refreshIntervalId);
            if (countdownIntervalId) clearInterval(countdownIntervalId);
            
            refreshIntervalId = setInterval(() => {
                if (!isRefreshPaused) {
                    window.location.reload();
                }
            }, refreshInterval);
            
            startCountdown();
        }

        function startCountdown() {
            refreshTimer = Math.floor(refreshInterval / 1000);
            updateCountdownDisplay();
            
            countdownIntervalId = setInterval(() => {
                if (!isRefreshPaused) {
                    refreshTimer--;
                    updateCountdownDisplay();
                    
                    if (refreshTimer <= 0) {
                        refreshTimer = Math.floor(refreshInterval / 1000);
                    }
                }
            }, 1000);
        }

        function updateCountdownDisplay() {
            const seconds = refreshTimer % 60;
            const countdown = document.getElementById('refresh-countdown');
            if (countdown) {
                countdown.textContent = `00:${seconds.toString().padStart(2, '0')}`;
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Initialize cookie method
            toggleCookieInputs();
            
            // Add event listeners
            const cookieMethod = document.getElementById('cookieMethod');
            if (cookieMethod) {
                cookieMethod.addEventListener('change', toggleCookieInputs);
            }
            
            // Auto-refresh ab by default start NAHI hoga
            // Sirf button dabane pe chalega
            const refreshToggle = document.getElementById('refresh-toggle');
            if (refreshToggle) {
                refreshToggle.textContent = 'START AUTO REFRESH';  // initial text
                refreshToggle.addEventListener('click', function() {
                    isRefreshPaused = !isRefreshPaused;
                    
                    if (isRefreshPaused) {
                        this.textContent = 'START AUTO REFRESH';
                        const spinner = document.getElementById('refresh-spinner');
                        if (spinner) spinner.classList.remove('fa-spin');
                        if (refreshIntervalId) clearInterval(refreshIntervalId);
                        if (countdownIntervalId) clearInterval(countdownIntervalId);
                    } else {
                        this.textContent = 'PAUSE AUTO REFRESH';
                        const spinner = document.getElementById('refresh-spinner');
                        if (spinner) spinner.classList.add('fa-spin');
                        startAutoRefresh();
                    }
                });
            }
            
            // Form validation (unchanged)
            document.querySelectorAll('form').forEach(form => {
                form.addEventListener('submit', function(e) {
                    const requiredInputs = form.querySelectorAll('input[required], textarea[required], select[required]');
                    let isValid = true;
                    
                    requiredInputs.forEach(input => {
                        if (!input.value.trim()) {
                            isValid = false;
                            input.style.borderColor = 'var(--danger-red)';
                            
                            setTimeout(() => {
                                input.style.borderColor = '';
                            }, 2000);
                        }
                    });
                    
                    if (!isValid) {
                        e.preventDefault();
                        const errorId = form.id === 'start-form' ? 'start-error' : 'stop-error';
                        const errorMsg = document.getElementById(errorId);
                        if (errorMsg) {
                            errorMsg.style.display = 'block';
                            setTimeout(() => {
                                errorMsg.style.display = 'none';
                            }, 3000);
                        }
                        return false;
                    }
                });
            });
            
            // Ripple effect (unchanged)
            document.querySelectorAll('.cyber-btn, .copy-btn, .refresh-toggle').forEach(button => {
                button.addEventListener('click', function(e) {
                    const ripple = document.createElement('span');
                    const rect = this.getBoundingClientRect();
                    const size = Math.max(rect.width, rect.height);
                    const x = e.clientX - rect.left - size / 2;
                    const y = e.clientY - rect.top - size / 2;
                    
                    ripple.style.cssText = `
                        position: absolute;
                        border-radius: 50%;
                        background: rgba(255, 255, 255, 0.2);
                        transform: scale(0);
                        animation: ripple 0.4s linear;
                        pointer-events: none;
                        width: ${size}px;
                        height: ${size}px;
                        left: ${x}px;
                        top: ${y}px;
                    `;
                    
                    this.appendChild(ripple);
                    
                    setTimeout(() => {
                        ripple.remove();
                    }, 400);
                });
            });
        });

        // Ripple animation CSS
        const rippleStyle = document.createElement('style');
        rippleStyle.textContent = `
            @keyframes ripple {
                to {
                    transform: scale(2);
                    opacity: 0;
                }
            }
        `;
        document.head.appendChild(rippleStyle);
    </script>
</body>
</html>